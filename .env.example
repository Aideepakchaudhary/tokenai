# ChainMate Environment Variables
# Copy this file to .env for local development
# For Vercel deployment, set these in your Vercel dashboard

# Server Configuration (for local development only)
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# The Graph Token API (optional - uses public endpoint by default)
TOKEN_API_BASE_URL=https://token-api.thegraph.com
# GRAPH_API_KEY=your_graph_api_key_here

# OpenAI Configuration (REQUIRED for chat functionality)
OPENAI_API_KEY=your_openai_api_key_here

# Node Environment
NODE_ENV=development

# Optional: Database configuration if needed later
# DATABASE_URL=your_database_url_here

# Optional: Redis configuration for caching if needed later
# REDIS_URL=your_redis_url_here

# Example values:
# OPENAI_API_KEY=sk-proj-abc123...
# NODE_ENV=development
